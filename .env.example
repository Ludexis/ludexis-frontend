# Ludexis frontend environment
# Copy to .env and adjust for your deployment.

# Base URL of the Ludexis backend API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Base URL of the backend media server (artwork covers, banners, screenshots).
NEXT_PUBLIC_MEDIA_URL=http://localhost:8000/media

# Set to 1 to enable verbose API request logging in the browser console.
NEXT_PUBLIC_DEBUG=0
